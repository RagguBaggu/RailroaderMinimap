<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RailroaderMinimapServer</AssemblyName>
    <RootNamespace>RailroaderMinimapServer</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Update this path to your Railroader root folder -->
    <RailroaderDir>C:\Program Files (x86)\Steam\steamapps\common\Railroader</RailroaderDir>
    <!-- Where DeployToModsFolder (bottom of this file) copies the built mod
         after each build, so it's immediately ready to test in-game. The
         game's built-in mod loader reads Documents\Railroader\Mods, NOT the
         Mods folder under the game's install directory (that one is UMM's).
         Override with -p:ModDeployDir=... if the game is launched with
         -homedir pointing somewhere else. -->
    <ModDeployDir>$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))\Railroader\Mods\RailroaderMinimapServer</ModDeployDir>
  </PropertyGroup>

  <!-- The companion app's HTML/CSS/JS is bundled directly into the DLL as
       an embedded resource and served by the mod's own HTTP server, so
       there's nothing extra to host or distribute: one file, one URL. -->
  <ItemGroup>
    <EmbeddedResource Include="CompanionApp.html" />
  </ItemGroup>

  <!-- Copy Info.json alongside the built DLL so the output folder is a
       complete, ready-to-install mod folder for the game's built-in loader. -->
  <ItemGroup>
    <None Include="Info.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Game Assemblies. Every one of these ships with the game itself, so
       the built mod has no dependencies of its own to bundle. -->
  <ItemGroup>
    <Reference Include="Core">
      <HintPath>$(RailroaderDir)\Railroader_Data\Managed\Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Railroader 2026.1 moved nearly all game code (formerly split
         between Assembly-CSharp.dll and Definition.dll) into this one
         assembly. Assembly-CSharp.dll is now a near-empty stub and
         Definition.dll no longer exists. -->
    <Reference Include="Railroader">
      <HintPath>$(RailroaderDir)\Railroader_Data\Managed\Railroader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- The game's own mod API (IModEntryPoint, IModContext, ...), used by
         GameModEntry.cs for the built-in mod loader. -->
    <Reference Include="Railroader.Modding">
      <HintPath>$(RailroaderDir)\Railroader_Data\Managed\Railroader.Modding.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RailroaderDir)\Railroader_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RailroaderDir)\Railroader_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Physics.Raycast/RaycastHit, used by the camera-warp feature to find
         real ground height at a tapped map point. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RailroaderDir)\Railroader_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RailroaderDir)\Railroader_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- AutoEngineerPersistence.Orders (Model.AI) is backed by a
         KeyValueObject, whose type lives in this separate assembly rather
         than Railroader.dll itself. -->
    <Reference Include="KeyValue.Runtime">
      <HintPath>$(RailroaderDir)\Railroader_Data\Managed\KeyValue.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- WebSocketSharp: Unity/Mono's HttpListener does NOT implement
         WebSocket support (AcceptWebSocketAsync throws
         NotImplementedException at runtime, even though it compiles fine
         against the net48 reference assemblies). WebSocketSharp implements
         the WebSocket protocol itself over raw sockets. The game ships its
         own copy since 2026.1 (for its built-in HTTP server), so this mod
         references that one instead of bundling a NuGet copy. -->
    <Reference Include="WebSocketSharp">
      <HintPath>$(RailroaderDir)\Railroader_Data\Managed\WebSocketSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Copies the two files README's Installation section lists as
       required (the DLL and Info.json) straight into the game's Mods folder
       after every build, so a fresh build is immediately ready to test
       in-game with no manual copy step. DestinationFolder creates
       ModDeployDir itself if it doesn't exist yet. -->
  <Target Name="DeployToModsFolder" AfterTargets="Build">
    <ItemGroup>
      <ModDeployFiles Include="$(OutDir)RailroaderMinimapServer.dll" />
      <ModDeployFiles Include="$(OutDir)Info.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ModDeployFiles)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
